# -*- mode: snippet -*-
# name: Keep ansible collections up-to-date
# key: ansible
# --

#!/usr/bin/env bash

function _ensure_requirements {
    local DIR_NAME=\${1:-collections}

    export ANSIBLE_COLLECTIONS_PATHS="$(pwd)/collections"
    
    if [ ! -e "requirements.yml" ]; then
        echo "No requirements file found, skipping setup..."
        return
    fi
    
    if [ ! -d "$DIR_NAME" ] || [ "requirements.yml" -nt "$DIR_NAME" ]; then
        echo "Updating Ansible collections..."
        ansible-galaxy collection install -r requirements.yml
        touch -c "$DIR_NAME"
    else
        echo "Ansible collections are up-to-date"
    fi
}

_ensure_requirements "$@"
unset -f _ensure_requirements
