{% set revision = nixos_revision | default("nixos-unstable", true) -%}
{
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/{{revision}}";
  };

  outputs = { self, nixpkgs }: let
    system = "x86_64-linux";
    pkgs = nixpkgs.legacyPackages.${system};
  in {
    devShells.${system}.default = pkgs.mkShellNoCC {
      packages = with pkgs;[
        gnumake
        just
        (texliveSmall.withPackages (ps: with ps; [
          wrapfig
          capt-of
          datetime2
          siunitx
          fontspec
          l3packages # xparse
          fontawesome5
          titlesec
          enumitem
          atkinson
          charissil
        ]))
      ];

      shellHook = ''
        export TEXINPUTS="$PWD/cls:";
      '';
    };
  };
}
